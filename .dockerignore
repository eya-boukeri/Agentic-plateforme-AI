# Environnements virtuels Python
venv/
venv-64/
.venv/
env/

# Cache Python et builds
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
dist/
build/
*.egg
*.egg-info/

# Git et configuration IDE
.git/
.gitignore
.claude/
.gemini/
.vscode/
.idea/

# Variables d'environnement locales
.env
.env.*

# Fichiers de log et rapports générés
logs/
*.log
output/pdf/*
output/logs/*
output/maps/*
output/graphs/*
!output/**/.gitkeep

